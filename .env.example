# Google Places API (New): búsqueda de negocios
GOOGLE_PLACES_API_KEY=
# Stripe (Developers > API keys): clave secreta sk_live_... (o sk_test_... para probar)
STRIPE_SECRET_KEY=
# Opcional: URL pública de la app, p. ej. https://closer.vercel.app
PUBLIC_URL=
# Contraseña de acceso a la app (obligatoria; sin ella las APIs se bloquean)
APP_PASSWORD=
